# =============================================================================
# PROVIDER CONFIGURATION - Modular Data Source System
# =============================================================================

# Default provider to use (gold_api, metalprice, finnhub)
DEFAULT_PROVIDER=gold_api

# Enable automatic failover to backup providers
PROVIDER_FALLBACK_ENABLED=true

# Provider API Keys
# Get MetalpriceAPI key: https://metalpriceapi.com/
METALPRICE_API_KEY=

# Get Finnhub key: https://finnhub.io/register
FINNHUB_API_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gold_prediction
# For local development with SQLite (fallback):
# DATABASE_URL=sqlite:///data/gold_prediction.db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Real-Time Settings
WEBSOCKET_RECONNECT_DELAY=30
POLLING_INTERVAL=10
MAX_RETRIES=5

# Gold API safety settings (cache must never be lower than 35 seconds)
GOLD_API_CACHE_SECONDS=35
GOLD_API_POLLING_INTERVAL=60
MAXIMUM_LIVE_PRICE_AGE_SECONDS=180
LIVE_CLOCK_SKEW_SECONDS=120
PREDICTION_ACTUAL_TOLERANCE_SECONDS=90
PREDICTION_CANDLE_MAX_AGE_SECONDS=259200

# Model Settings
MODEL_UPDATE_INTERVAL=3600  # 1 hour in seconds
PREDICTION_CONFIDENCE_THRESHOLD=0.85
MIN_SAMPLES_FOR_RETRAIN=50
RETRAIN_INTERVAL_HOURS=24
RETRAIN_CHECK_INTERVAL=60
TRAINING_MAX_CANDLES=250000
TRAINING_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15
MINIMUM_TEST_SAMPLES=100
PROMOTION_REGRESSION_TOLERANCE=0.02
PERFORMANCE_MINIMUM_SAMPLES=50

# Historical ZIP bulk import (trusted server-side paths only)
HISTORICAL_DATA_ALLOWED_IMPORT_ROOT=data/historical
HISTORICAL_DATA_IMPORT_DIRECTORY=data/historical/xauusd
HISTORICAL_DATA_BATCH_SIZE=10000
HISTORICAL_DATA_MAXIMUM_UNCOMPRESSED_FILE_SIZE=2147483648
HISTORICAL_DATA_MAXIMUM_ARCHIVE_UNCOMPRESSED_SIZE=4294967296
HISTORICAL_DATA_MAXIMUM_COMPRESSION_RATIO=200
HISTORICAL_DATA_MAXIMUM_ARCHIVE_ENTRIES=100

# Dashboard Settings
AUTO_REFRESH_INTERVAL=2  # seconds
CHART_CANDLES_COUNT=200
DEFAULT_CURRENCY=USD

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================================================
# MACHINE LEARNING SETTINGS
# =============================================================================
MODEL_DIR=models
DEFAULT_MODEL=benchmark
CANDIDATE_ALGORITHMS=linear_regression,random_forest,xgboost
FEATURE_WINDOW=30
PREDICTION_HORIZON=1d
MODEL_UPDATE_INTERVAL=3600  # 1 hour in seconds
PREDICTION_CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# WEBSOCKET & STREAMING SETTINGS
# =============================================================================
WEBSOCKET_PORT=8765
STREAM_BUFFER_SIZE=1000

# =============================================================================
# SYMBOLS & CURRENCIES
# =============================================================================
DEFAULT_SYMBOL=XAU
DEFAULT_CURRENCY=USD
# Durable background lifecycle
PREDICTION_INTERVAL_SECONDS=60
PREDICTION_EVALUATION_INTERVAL_SECONDS=30
PREDICTION_HORIZONS=3,5,15,30,60,240
WORKER_HEARTBEAT_SECONDS=15
WORKER_UNHEALTHY_AFTER_SECONDS=60

# Analytical notifications; leave URL empty to keep notifications in-app only.
ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_SECONDS=10
ALERT_MAX_RETRIES=3
ALERT_COOLDOWN_SECONDS=300
ALERT_MIN_TEST_IMPROVEMENT_OVER_BASELINE_PCT=0
ALERT_MIN_LIVE_EVALUATED_SAMPLES=30
ALERT_MIN_LIVE_DIRECTIONAL_ACCURACY_PCT=55
ALERT_MIN_ABSOLUTE_PREDICTED_RETURN_PCT=0.05
ALERT_PROBATION_WEBHOOKS_ENABLED=false
