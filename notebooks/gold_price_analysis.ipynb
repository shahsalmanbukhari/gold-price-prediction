    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load cleaned data\\n\",\n",
    "    \"df_clean = pd.read_csv('../data/processed/gold_prices_clean.csv')\\n\",\n",
    "    \"df_clean['Date'] = pd.to_datetime(df_clean['Date'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Dataset Shape: {df_clean.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Date Range: {df_clean['Date'].min().date()} to {df_clean['Date'].max().date()}\\\")\\n\",\n",
    "    \"df_clean.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Data Exploration\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Summary statistics\\n\",\n",
    "    \"df_clean[['Close_PKR_per_tola', 'Daily_Return']].describe()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Plot historical prices\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 1, figsize=(14, 10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Price over time\\n\",\n",
    "    \"axes[0].plot(df_clean['Date'], df_clean['Close_PKR_per_tola'], color='gold', linewidth=2)\\n\",\n",
    "    \"axes[0].set_title('Gold Price Over Time (PKR per tola)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"axes[0].set_xlabel('Date')\\n\",\n",
    "    \"axes[0].set_ylabel('Price (PKR)')\\n\",\n",
    "    \"axes[0].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Daily returns\\n\",\n",
    "    \"axes[1].plot(df_clean['Date'], df_clean['Daily_Return'], color='blue', alpha=0.7)\\n\",\n",
    "    \"axes[1].axhline(y=0, color='red', linestyle='--', linewidth=1)\\n\",\n",
    "    \"axes[1].set_title('Daily Returns (%)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"axes[1].set_xlabel('Date')\\n\",\n",
    "    \"axes[1].set_ylabel('Return (%)')\\n\",\n",
    "    \"axes[1].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Load Featured Data\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load featured dataset\\n\",\n",
    "    \"df_featured = pd.read_csv('../data/processed/gold_prices_featured.csv')\\n\",\n",
    "    \"df_featured['Date'] = pd.to_datetime(df_featured['Date'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Featured Dataset Shape: {df_featured.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Total Features: {df_featured.shape[1] - 10}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nSample Features:\\\")\\n\",\n",
    "    \"print(df_featured.columns[10:20].tolist())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Load Trained Models\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load models\\n\",\n",
    "    \"lr_model = joblib.load('../models/linear_regression_model.pkl')\\n\",\n",
    "    \"rf_model = joblib.load('../models/random_forest_model.pkl')\\n\",\n",
    "    \"scaler = joblib.load('../models/scaler.pkl')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"✓ Models loaded successfully\\\")\\n\",\n",
    "    \"print(f\\\"  - Linear Regression\\\")\\n\",\n",
    "    \"print(f\\\"  - Random Forest ({rf_model.n_estimators} trees)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Model Performance\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load model comparison\\n\",\n",
    "    \"comparison = pd.read_csv('../reports/model_comparison.csv')\\n\",\n",
    "    \"print(\\\"Model Performance Comparison:\\\\n\\\")\\n\",\n",
    "    \"print(comparison.to_string(index=False))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Make Predictions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Prepare latest data for prediction\\n\",\n",
    "    \"exclude_cols = ['Date', 'target', 'Close_PKR_per_tola', 'Open_PKR_per_tola', \\n\",\n",
    "    \"               'High_PKR_per_tola', 'Low_PKR_per_tola', 'Close_PKR_per_gram',\\n\",\n",
    "    \"               'Close_USD_per_oz', 'Close_PKR_per_oz', 'Adj Close', 'Volume']\\n\",\n",
    "    \"\\n\",\n",
    "    \"feature_cols = [col for col in df_featured.columns if col not in exclude_cols]\\n\",\n",
    "    \"\\n\",\n",
    "    \"latest_row = df_featured.iloc[-1:].copy()\\n\",\n",
    "    \"X_latest = latest_row[feature_cols]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Linear Regression prediction (scaled)\\n\",\n",
    "    \"X_latest_scaled = scaler.transform(X_latest)\\n\",\n",
    "    \"lr_pred = lr_model.predict(X_latest_scaled)[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Random Forest prediction (unscaled)\\n\",\n",
    "    \"rf_pred = rf_model.predict(X_latest)[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"latest_date = latest_row['Date'].values[0]\\n\",\n",
    "    \"latest_price = latest_row['Close_PKR_per_tola'].values[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Latest Date: {pd.to_datetime(latest_date).date()}\\\")\\n\",\n",
    "    \"print(f\\\"Latest Price: PKR {latest_price:,.2f} per tola\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nNext-Day Predictions:\\\")\\n\",\n",
    "    \"print(f\\\"  Linear Regression: PKR {lr_pred:,.2f} ({(lr_pred-latest_price)/latest_price*100:+.2f}%)\\\")\\n\",\n",
    "    \"print(f\\\"  Random Forest:     PKR {rf_pred:,.2f} ({(rf_pred-latest_price)/latest_price*100:+.2f}%)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Feature Importance (Random Forest)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Get feature importance\\n\",\n",
    "    \"importances = rf_model.feature_importances_\\n\",\n",
    "    \"feature_importance_df = pd.DataFrame({\\n\",\n",
    "    \"    'Feature': feature_cols,\\n\",\n",
    "    \"    'Importance': importances\\n\",\n",
    "    \"}).sort_values('Importance', ascending=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot top 20\\n\",\n",
    "    \"top_features = feature_importance_df.head(20)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(10, 8))\\n\",\n",
    "    \"plt.barh(range(len(top_features)), top_features['Importance'], color='steelblue')\\n\",\n",
    "    \"plt.yticks(range(len(top_features)), top_features['Feature'])\\n\",\n",
    "    \"plt.xlabel('Importance', fontsize=12)\\n\",\n",
    "    \"plt.ylabel('Features', fontsize=12)\\n\",\n",
    "    \"plt.title('Top 20 Feature Importances (Random Forest)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"plt.gca().invert_yaxis()\\n\",\n",
    "    \"plt.grid(True, alpha=0.3, axis='x')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nTop 10 Most Important Features:\\\")\\n\",\n",
    "    \"print(feature_importance_df.head(10).to_string(index=False))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 9. Technical Indicators Visualization\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Plot recent data with technical indicators\\n\",\n",
    "    \"recent_data = df_featured.tail(180).copy()  # Last 6 months\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(3, 1, figsize=(14, 12))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Price with Bollinger Bands\\n\",\n",
    "    \"axes[0].plot(recent_data['Date'], recent_data['Close_PKR_per_tola'], label='Price', color='black', linewidth=2)\\n\",\n",
    "    \"axes[0].plot(recent_data['Date'], recent_data['Close_PKR_per_tola_bb_upper'], label='BB Upper', color='red', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"axes[0].plot(recent_data['Date'], recent_data['Close_PKR_per_tola_bb_lower'], label='BB Lower', color='green', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"axes[0].plot(recent_data['Date'], recent_data['Close_PKR_per_tola_bb_middle'], label='BB Middle', color='blue', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"axes[0].fill_between(recent_data['Date'], recent_data['Close_PKR_per_tola_bb_lower'], \\n\",\n",
    "    \"                      recent_data['Close_PKR_per_tola_bb_upper'], alpha=0.1)\\n\",\n",
    "    \"axes[0].set_title('Price with Bollinger Bands', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"axes[0].set_ylabel('Price (PKR)')\\n\",\n",
    "    \"axes[0].legend()\\n\",\n",
    "    \"axes[0].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# RSI\\n\",\n",
    "    \"axes[1].plot(recent_data['Date'], recent_data['Close_PKR_per_tola_rsi_14'], color='purple', linewidth=2)\\n\",\n",
    "    \"axes[1].axhline(y=70, color='red', linestyle='--', linewidth=1, label='Overbought (70)')\\n\",\n",
    "    \"axes[1].axhline(y=30, color='green', linestyle='--', linewidth=1, label='Oversold (30)')\\n\",\n",
    "    \"axes[1].set_title('RSI (14-period)', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"axes[1].set_ylabel('RSI')\\n\",\n",
    "    \"axes[1].set_ylim(0, 100)\\n\",\n",
    "    \"axes[1].legend()\\n\",\n",
    "    \"axes[1].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# MACD\\n\",\n",
    "    \"axes[2].plot(recent_data['Date'], recent_data['Close_PKR_per_tola_macd'], label='MACD', color='blue', linewidth=2)\\n\",\n",
    "    \"axes[2].plot(recent_data['Date'], recent_data['Close_PKR_per_tola_macd_signal'], label='Signal', color='red', linewidth=2)\\n\",\n",
    "    \"axes[2].bar(recent_data['Date'], recent_data['Close_PKR_per_tola_macd_histogram'], label='Histogram', alpha=0.3)\\n\",\n",
    "    \"axes[2].axhline(y=0, color='black', linestyle='-', linewidth=0.5)\\n\",\n",
    "    \"axes[2].set_title('MACD', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"axes[2].set_ylabel('MACD')\\n\",\n",
    "    \"axes[2].set_xlabel('Date')\\n\",\n",
    "    \"axes[2].legend()\\n\",\n",
    "    \"axes[2].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 10. Correlation Analysis\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Select important features for correlation\\n\",\n",
    "    \"important_features = [\\n\",\n",
    "    \"    'Close_PKR_per_tola_lag_1',\\n\",\n",
    "    \"    'Close_PKR_per_tola_lag_7',\\n\",\n",
    "    \"    'Close_PKR_per_tola_rolling_mean_7',\\n\",\n",
    "    \"    'Close_PKR_per_tola_ema_14',\\n\",\n",
    "    \"    'Close_PKR_per_tola_rsi_14',\\n\",\n",
    "    \"    'Close_PKR_per_tola_macd',\\n\",\n",
    "    \"    'volatility_14',\\n\",\n",
    "    \"    'target'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"corr_matrix = df_featured[important_features].corr()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(10, 8))\\n\",\n",
    "    \"sns.heatmap(corr_matrix, annot=True, fmt='.2f', cmap='coolwarm', center=0,\\n\",\n",
    "    \"            square=True, linewidths=1, cbar_kws={\\\"shrink\\\": 0.8})\\n\",\n",
    "    \"plt.title('Feature Correlation Matrix', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 11. Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Key Findings:\\n\",\n",
    "    \"1. **Best Model:** Linear Regression (RMSE: 2,656 PKR, R²: 0.9693)\\n\",\n",
    "    \"2. **Most Important Features:** Lag features (previous day prices)\\n\",\n",
    "    \"3. **Data Quality:** Clean dataset with no missing values\\n\",\n",
    "    \"4. **Prediction Accuracy:** ~1.0% MAPE (excellent for financial data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Recommendations:\\n\",\n",
    "    \"- Use Linear Regression for production predictions\\n\",\n",
    "    \"- Monitor model performance weekly\\n\",\n",
    "    \"- Retrain with new data monthly\\n\",\n",
    "    \"- Consider ensemble methods for improved accuracy\"\n",
    "   ]\n",
    "  }\n",
